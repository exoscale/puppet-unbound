stub-zone:
  name: "<%= @name %>"
<% if @address -%>
<% addrs = PuppetX::Unbound::ValidateAddrs.new(@address) -%>
<% addrs.name_list.each do |addr| -%>
  stub-host: <%= addr %>
<% end -%>
<% addrs.ip_list.each do |addr| -%>
  stub-addr: <%= addr %>
<% end -%>
<% end -%>
<% if @stub_first == 'yes' || @stub_first.to_s == 'true'-%>
  stub-first: yes
<% end -%>
<% if @stub_no_cache == 'yes' || @no_cache.to_s == 'true' -%>
  stub-no-cache: yes
<% end -%>
